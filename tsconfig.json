{
	"compilerOptions": {
		"baseUrl": ".",
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"allowJs": true,
		"noImplicitAny": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["DOM", "ES2022"],
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
